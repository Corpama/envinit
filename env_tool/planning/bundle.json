{
  "defaults": {
    "mgmt_bond_name": "bond0",
    "mgmt_interfaces": [
      "ens12f0np0",
      "ens12f1np1"
    ],
    "mgmt_prefix": 23,
    "mgmt_gateway": "10.157.4.1",
    "mgmt_nameservers": [],
    "mgmt_mtu": 1500,
    "bond_mode": "active-backup",
    "bond_lacp_rate": "",
    "bond_transmit_hash_policy": "",
    "bond_mii_monitor_interval": 100,
    "bond_primary": "ens12f1np1",
    "rdma_exsist": true,
    "rdma_configure_ip_route": false,
    "rdma_prefix": 24,
    "rdma_mtu": 9000,
    "rdma_route_cidr": "",
    "route_priority": 32761,
    "backup_existing_netplan": true,
    "disable_existing_apt_sources": true,
    "rdma_interfaces": [
      {
        "name": "ens15np0"
      },
      {
        "name": "ens16np0"
      },
      {
        "name": "ens13np0"
      },
      {
        "name": "ens14np0"
      }
    ]
  },
  "offline_apt": {
    "enabled": true,
    "material_path": "/mnt/usb/env_tool/data/repo",
    "copy_to": "/opt/repo",
    "target_file": "/etc/apt/sources.list.d/kunlun-offline.list",
    "entries": [
      "deb [trusted=yes] file:{{offline_apt_target}} jammy main"
    ]
  },
  "packages": [
    "linux-headers-{{uname_r}}",
    "ipmitool",
    "bzip2",
    "gcc",
    "wget",
    "curl",
    "nginx"
  ],
  "artifacts": {
    "work_dir": "/opt/kunlun",
    "ofed_archive": "/mnt/usb/env_tool/data/MLNX_OFED_LINUX-24.01-0.3.3.1-ubuntu22.04-x86_64.tgz",
    "xre_installer": "/mnt/usb/env_tool/data/xre-Linux-x86_64-5.19.0.0.run",
    "xre_args": [
      "-q"
    ],
    "xdr_archive": "/mnt/usb/env_tool/data/xdr_copy-x86_64_1.1.0.6.tar.gz",
    "firmware_archive": "/mnt/usb/env_tool/data/update_fw_p900_2.23_1.58.tar.gz",
    "container_packages": [
      "/mnt/usb/env_tool/data/libxpu-container-tools_1.0.2-1_amd64.deb",
      "/mnt/usb/env_tool/data/libxpu-container1_1.0.2-1_amd64.deb",
      "/mnt/usb/env_tool/data/xpu-container-toolkit_1.0.5-1_amd64.deb"
    ]
  },
  "xre": {
    "card_model": "P900"
  },
  "mlxconfig": {
    "device_glob": "/dev/mst/mt4129_pciconf*",
    "settings": {
      "CNP_DSCP_P1": "48"
    }
  },
  "check": {
    "iterations": 100,
    "report_gbits": true,
    "min_gbits": 0,
    "parallel": true,
    "rdma_ping_count": 3,
    "rdma_ping_payload_size": 8972,
    "rdma_ping_timeout": 2,
    "ssh_user": "root",
    "ssh_options": [],
    "rdma_groups": [
      {
        "ib_device": "mlx5_1",
        "xpu_offsets": [
          "0x0000000090001000",
          "0x1000000090001000"
        ]
      },
      {
        "ib_device": "mlx5_2",
        "xpu_offsets": [
          "0x2000000090001000",
          "0x3000000090001000"
        ]
      },
      {
        "ib_device": "mlx5_3",
        "xpu_offsets": [
          "0x4000000090001000",
          "0x5000000090001000"
        ]
      },
      {
        "ib_device": "mlx5_4",
        "xpu_offsets": [
          "0x6000000090001000",
          "0x7000000090001000"
        ]
      }
    ]
  },
  "post_packages": [],
  "post_tasks": [
    {
      "name": "install xpu_exporter",
      "type": "copy",
      "source": "/mnt/usb/env_tool/xpu_exporter",
      "target": "/usr/local/bin/xpu_exporter",
      "mode": "0755"
    },
    {
      "name": "install xpu_exporter service",
      "type": "copy",
      "source": "/mnt/usb/env_tool/xpu_exporter.service",
      "target": "/etc/systemd/system/xpu_exporter.service",
      "mode": "0644"
    },
    {
      "name": "enable and start xpu_exporter",
      "type": "cmd",
      "command": "systemctl daemon-reload && systemctl enable xpu_exporter && systemctl restart xpu_exporter"
    }
  ],
  "post_power_action": {
    "action": "soft",
    "confirm": true
  }
}
