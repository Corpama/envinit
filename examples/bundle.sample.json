{
  "defaults": {
    "mgmt_bond_name": "bond0",
    "mgmt_interfaces": ["ens20f0np0", "ens20f1np1"],
    "mgmt_prefix": 26,
    "mgmt_gateway": "10.101.9.1",
    "mgmt_nameservers": [],
    "mgmt_mtu": 1500,
    "bond_mode": "802.3ad",
    "bond_lacp_rate": "slow",
    "bond_transmit_hash_policy": "layer3+4",
    "bond_primary": "",
    "rdma_prefix": 24,
    "rdma_mtu": 9000,
    "rdma_route_cidr": "11.1.0.0/21",
    "rdma_exsist": true,
    "rdma_configure_ip_route": true,
    "route_priority": 32761,
    "backup_existing_netplan": true,
    "disable_existing_apt_sources": false,
    "rdma_interfaces": [
      { "name": "ens11np0", "table": 101 },
      { "name": "ens13np0", "table": 102 },
      { "name": "ens15np0", "table": 103 },
      { "name": "ens17np0", "table": 104 }
    ]
  },
  "offline_apt": {
    "enabled": true,
    "material_path": "/mnt/usb/repo",
    "copy_to": "/opt/repo",
    "target_file": "/etc/apt/sources.list.d/kunlun-offline.list",
    "entries": [
      "deb [trusted=yes] file:{{offline_apt_target}} jammy main"
    ]
  },
  "packages": [
    "linux-headers-{{uname_r}}",
    "ipmitool",
    "lsof"
  ],
  "artifacts": {
    "work_dir": "/opt/kunlun",
    "ofed_archive": "/mnt/usb/MLNX_OFED_LINUX-24.01-0.3.3.1-ubuntu22.04-x86_64.tgz",
    "xre_installer": "/mnt/usb/xre-Linux-x86_64-5.0.21.24.4.run",
    "xre_args": [],
    "xdr_archive": "/mnt/usb/xdr_copy-x86_64_1.1.0.6.tar.gz",
    "firmware_archive": "/mnt/usb/update_fw_p800_2.15_1.48.tar.gz",
    "container_packages": [
      "/mnt/usb/libxpu-container-tools_1.0.2-1_amd64.deb",
      "/mnt/usb/libxpu-container1_1.0.2-1_amd64.deb",
      "/mnt/usb/xpu-container-toolkit_1.0.5-1_amd64.deb"
    ]
  },
  "xre": {
    "card_model": "P800"
  },
  "mlxconfig": {
    "device_glob": "/dev/mst/mt4129_pciconf*",
    "settings": {
      "CNP_DSCP_P1": "48"
    }
  },
  "check": {
    "iterations": 100,
    "report_gbits": true,
    "min_gbits": 0,
    "ssh_user": "root",
    "ssh_options": [],
    "rdma_ping_count": 3,
    "rdma_ping_payload_size": 8972,
    "rdma_ping_timeout": 2,
    "rdma_groups": [
      {
        "ib_device": "mlx5_1",
        "xpu_offsets": [
          "0x0000000090001000",
          "0x1000000090001000"
        ]
      },
      {
        "ib_device": "mlx5_2",
        "xpu_offsets": [
          "0x2000000090001000",
          "0x3000000090001000"
        ]
      },
      {
        "ib_device": "mlx5_3",
        "xpu_offsets": [
          "0x4000000090001000",
          "0x5000000090001000"
        ]
      },
      {
        "ib_device": "mlx5_4",
        "xpu_offsets": [
          "0x6000000090001000",
          "0x7000000090001000"
        ]
      }
    ]
  },
  "post_packages": [],
  "post_tasks": [
    {
      "name": "install custom service",
      "type": "copy",
      "source": "/mnt/usb/my-agent.service",
      "target": "/etc/systemd/system/my-agent.service",
      "mode": "0644"
    },
    {
      "name": "reload systemd",
      "type": "cmd",
      "command": "systemctl daemon-reload"
    }
  ],
  "post_power_action": {
    "action": "soft",
    "confirm": true
  }
}
