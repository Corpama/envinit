    "bond_mii_monitor_interval": 100,
    "bond_primary": "",
    "rdma_mtu": 9000,
    "rdma_mode": "full",
    "route_priority": 32761
  },
  "platform": {
    "os_family": "ubuntu",
    "package_manager": "apt",
    "network_backend": "netplan"
  },
  "offline_repo": {
    "enabled": true,
    "material_path": "data/apt-repo",
