{
  "apply_timeouts": {
    "default_seconds": 360,
    "stages": {
      "software": 360,
      "ofed": 0,
      "network": 360,
      "xre": 0,
      "xdr": 0,
      "firmware": 0,
      "container": 360,
      "mlxconfig": 360,
      "sysctl": 360,
      "kernel": 360,
      "post": 0,
      "udev": 360
    }
  },
  "defaults": {
    "backup_existing_netplan": true,
    "backup_existing_network": false,
    "disable_existing_apt_sources": false,
    "disable_existing_repos": false,
    "backup_root": "/var/lib/envinit/backups",
    "rdma_gateway_probe": {
      "enabled": true,
      "attempts": 3,
      "timeout_seconds": 3,
      "link_wait_seconds": 5
