{
  "defaults": {
    "configure_management_network": true,
    "apply_network_immediately": true,
    "mgmt_bond_name": "bond0",
    "mgmt_prefix": 26,
    "mgmt_gateway": "10.101.9.1",
    "mgmt_nameservers": [],
    "mgmt_mtu": 1500,
    "bond_mode": "802.3ad",
    "bond_lacp_rate": "slow",
    "bond_transmit_hash_policy": "layer3+4",
    "rdma_prefix": 24,
    "rdma_mtu": 9000,
    "rdma_route_cidr": "11.1.0.0/21",
    "rdma_exist": true,
    "rdma_configure_ip_route": true,
    "route_priority": 32761
  },
  "platform_options": {
    "redhat": {
      "backup_existing_network": true
    }
  },
  "offline_repo": {
    "enabled": true,
    "material_path": "/mnt/usb/rpm-repo"
  },
  "packages": [
    "gcc",
    "make",
    "bzip2",
    "lsof",
    "ipmitool"
  ],
  "artifacts": {
    "work_dir": "/opt/kunlun",
    "ofed_archive": "/mnt/usb/MLNX_OFED_LINUX-rhel-or-kylin-x86_64.tgz",
    "xre_installer": "/mnt/usb/xre-Linux-x86_64.run",
    "xre_args": [],
    "xdr_archive": "/mnt/usb/xdr_copy-x86_64.tar.gz",
    "firmware_archive": "/mnt/usb/update_fw.tar.gz",
    "container_packages": [
      "/mnt/usb/libxpu-container-tools.rpm",
      "/mnt/usb/libxpu-container1.rpm",
      "/mnt/usb/xpu-container-toolkit.rpm"
    ]
  },
  "xre": {
    "card_model": "P800"
  },
  "mlxconfig": {
    "settings": {
      "CNP_DSCP_P1": "48"
    }
  },
  "check": {
    "rdma_groups": [
      { "ib_device": "mlx5_1", "xpu_offsets": ["0x0000000090001000", "0x1000000090001000"] },
      { "ib_device": "mlx5_2", "xpu_offsets": ["0x2000000090001000", "0x3000000090001000"] },
      { "ib_device": "mlx5_3", "xpu_offsets": ["0x4000000090001000", "0x5000000090001000"] },
      { "ib_device": "mlx5_4", "xpu_offsets": ["0x6000000090001000", "0x7000000090001000"] }
    ]
  },
  "post_packages": [],
  "post_tasks": [
    {
      "name": "install custom service",
      "type": "copy",
      "source": "/mnt/usb/my-agent.service",
      "target": "/etc/systemd/system/my-agent.service",
      "mode": "0644"
    },
    {
      "name": "reload systemd",
      "type": "cmd",
      "command": "systemctl daemon-reload"
    }
  ],
  "post_power_action": {
    "action": "soft",
    "confirm": true
  }
}
